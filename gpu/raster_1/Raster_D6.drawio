                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-506" value="ORDER IS SETS OF VERTICES IS ONE TRIANGLE .3 VERTICES PER TRIANGLE.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;tail -&amp;gt; C B A &amp;lt;- head&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="1087.98" y="3380" width="180" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-507" value="Do a hybrid ladder based approach. So start at the top most vertex. Go right until a quad produces nothing or bounding box, then go left until the same. Once the row is done, go to the next row. Note this will increase no.mult&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&amp;amp;arnumber=6851276&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="4540" y="820" width="210" height="60" as="geometry"/>
