                <mxCell id="_5K4IyTiggNPLRhWUsHf-513" value="Reg" style="whiteSpace=wrap;html=1;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="4322.02" y="1044.38" width="40" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-514" value="This lets us get rid of a bunch of mul units. Basically, with ladder you are always moving down, so you can set the edge_ini into multiplexer to be the new y adjusted." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="3835.02" y="798.98" width="148.05" height="102.05" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-515" value="To allow for moving to the left, instead of multiplying the x input by 1, we can set the adders to do - instead of + &amp;lt;- cheap!" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="4628.0199999999995" y="1175" width="150" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-516" value="*NEW* Vertex table will now store screen space coordinates and the corresponding vertex ID and z value!" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="2848.04" y="2930" width="210" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-517" value="Have primitive cache be per SM. Vertex ID is an address for that vertex and all its data inside the GPU VRAM. The point here is to avoid misses to memory every time a triangle shares a vertex, it is NOT to avoid the cold miss initially. This will be per subcore.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Looking at geometry, we know that worst case each quad will belong to a different triangle. So we can have 8 triangles per warp if all are independent, that&#39;s 24 vertices. Each vertex will have INT8 * 3 (RGB) + FP16 * 6 (x, y, z, a, u, v) =&amp;nbsp; 15 bytes + 1 byte of padding or something else. 16 byte blocks.&amp;nbsp;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="6270" y="3100" width="360" height="270" as="geometry"/>
                </mxCell>
