                <mxCell id="_5K4IyTiggNPLRhWUsHf-610" value="Z cache works on the principle that the dispatch stage serializes triangles that share the same or similar screen space. Therefore, the same parts of the z buffer will likely need to be checked against for consecutive z buffer reads. The block size allows an entire quad of zs to be loaded at once, so the entire quad can be checked against. This is write back cache. Entire pipeline is flushed only once, on the next draw call (per frame) that&#39;s it!" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-567" vertex="1">
                    <mxGeometry x="490" y="145" width="305.96" height="181" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-611" value="Z-Test Check 0" style="whiteSpace=wrap;html=1;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
