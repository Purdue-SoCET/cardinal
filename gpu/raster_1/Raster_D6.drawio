                <mxCell id="_5K4IyTiggNPLRhWUsHf-478" value="&lt;b&gt;&lt;font style=&quot;font-size: 21px;&quot;&gt;RR TRIANGLE BUS&lt;/font&gt;&lt;/b&gt;" style="whiteSpace=wrap;html=1;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="393.51" y="3270" width="2424.47" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-479" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.23;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="_5K4IyTiggNPLRhWUsHf-1" source="_5K4IyTiggNPLRhWUsHf-475" target="_5K4IyTiggNPLRhWUsHf-478" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-480" value="ready" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="_5K4IyTiggNPLRhWUsHf-479" connectable="0" vertex="1">
                    <mxGeometry x="-0.0226" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-481" value="Bus is atomic and round robin. Give a warp a chance to send over 2 to 3 triangles (6 to 9 vertices) worth of data. Entire system is okay because triangles that reuse vertices are likely to be next to each other. And if multiple vertices are the same in the table it&#39;s okay the current system just treats them as separate.&amp;nbsp;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="1438.57" y="3410" width="242.24" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-482" value="Vertex table has internal index that I&#39;m calling handle. Each slot has an activeBit to show whether the slot is free to accept a new value. Each slot holds 16 bytes of vertex data and ~1 byte of metadata. active is set high when a triangle is placed on the local triangle queue. There is also 5 bit triangle_count field that tracks how many triangles share that vertex. Active is set low when a triangle reaches the edge test stage and triangle_count is 0." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="2984.04" y="3260" width="250" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-483" value="The bit mask logic needs to be specified. It picks the LSB that is a 1. That is it. So if there&#39;s 12 entries, there&#39;s 12 bits and all are one. When something is put in, it will go in the first slot. Then, that is 0, so next will go in next slot. If a slot frees up, that will be used. priority encoder." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="2206.61" y="3130" width="185.54" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-484" value="Let SM send how many vertices it&#39;s sending with it." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="417.88" y="3390" width="170" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-485" value="TLB loads all indices at once. Get handles. Send indices back out as handles.&amp;nbsp;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="2057.98" y="2490" width="250" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-486" value="PIPELINE IS IMPLIED WITH THESE SHIFT REGISTERS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=16;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
