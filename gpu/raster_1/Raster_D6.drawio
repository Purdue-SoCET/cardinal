                    </mxGeometry>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-470" value="TLB will store indices and the corresponding handles they were mapped to. For example, warp sends in 5 vertices with triangles [0,1,2] [3,4,2]. Index 2 placed in TLB and handle it was placed in also placed in same slot of TLB.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;When it encounters the same index again, it is checked within the TLB. If a match is found, it goes to that handle in the vertex table and increments a vertex counter attribute that shows how many triangles share those vertices. Otherwise, it just adds the vertex to that handle.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The entire TLB is cleared when a new set of data is received on the bus.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="_5K4IyTiggNPLRhWUsHf-1" vertex="1">
                    <mxGeometry x="1510" y="2322.11" width="401.43" height="189.45" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-471" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" parent="_5K4IyTiggNPLRhWUsHf-1" source="_5K4IyTiggNPLRhWUsHf-475" target="_5K4IyTiggNPLRhWUsHf-459" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="_5K4IyTiggNPLRhWUsHf-472" value="index" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="_5K4IyTiggNPLRhWUsHf-471" connectable="0" vertex="1">
                    <mxGeometry x="-0.2629" y="4" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
